{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Modules": {
    "UserModule": {
      "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=ModularMonolith;Integrated Security=true;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true"
    },
    "AccountsModule": {
      "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=ModularMonolithAccounts;Integrated Security=true;Encrypt=False;TrustServerCertificate=True;MultipleActiveResultSets=true"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/ModularMonolith.Template.Api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
